---
import { SITE, LABELS, whatsappLink } from '../data/site';
import { INGREDIENT_CLAIM } from '../data/ingredients';
import { LOCATIONS } from '../data/locations';
import OpenStatus from './OpenStatus.astro';
import Icon from './Icon.astro';

const cyberjayaLoc = LOCATIONS[0];
const waHref = whatsappLink(`Hi ${SITE.shortName}, I would like to ask about ordering.`);

const trustBullets = [
  { label: 'No Pork & No Lard', mark: true },
  { label: `${INGREDIENT_CLAIM}+ Fresh Ingredients`, mark: true },
  { label: `Pay By Weight (${SITE.priceRange || 'RM 1–20'})`, mark: true },
  { label: 'Open 10:30 AM – 11:00 PM Daily', mark: true },
];
---

<section class="relative overflow-hidden bg-mala-ink text-white py-16 sm:py-24 lg:py-28 min-h-[580px] flex items-center">
  <!-- Full Bleed Storefront Background Photo -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/outlet-cyberjaya-day.webp"
      alt="Musafir Qi Malatang storefront at CBD Perdana 3 Cyberjaya"
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      class="h-full w-full object-cover object-center filter brightness-90 contrast-105 scale-105 transition-transform duration-1000"
    />
    <!-- Dark Vignette & Brand Red Gradient Overlay for Maximum Text Contrast -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/80 to-mala-ink/65"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/50"></div>
  </div>

  <div class="container-rail relative z-10 w-full">
    <div class="max-w-3xl animate-fadeInLeft">
      
      <!-- Location Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full bg-black/60 backdrop-blur-md px-4 py-1.5 text-xs font-bold tracking-wide text-white border border-white/20 shadow-lg">
        <span class="text-mala-gold">📍</span>
        <span>CBD Perdana 3, Cyberjaya & surrounding Selangor areas</span>
      </div>

      <!-- Main Business Title & Headline -->
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
        <span class="text-mala-gold uppercase tracking-wider block font-display text-5xl sm:text-6xl lg:text-7xl drop-shadow-md">
          {SITE.name}
        </span>
        <span class="mt-2 block text-2xl sm:text-3xl lg:text-4xl font-bold text-white/95">
          Halal Chinese Muslim Hot Pot, Charcoal Skewers & Malatang
        </span>
      </h1>

      <!-- Description Copy -->
      <p class="mt-5 text-base sm:text-lg lg:text-xl text-gray-200 leading-relaxed font-medium">
        Walk the ingredient bar, pick whatever you want from over {INGREDIENT_CLAIM} fresh ingredients, and pay by weight.
        <span class="font-bold text-white"> Rated 5.0/5 from 12 Google reviews.</span>
      </p>

      <!-- Google Rating Row -->
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-1.5 text-amber-400">
          <span class="text-lg">★★★★★</span>
          <span class="text-sm font-bold text-white">5.0</span>
          <span class="text-sm text-gray-300">• 12 Google reviews</span>
        </div>
        <span class="text-gray-500">•</span>
        <div class="inline-flex items-center gap-2">
          <OpenStatus location={cyberjayaLoc} />
        </div>
      </div>

      <!-- Main Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/menu"
          class="btn bg-white text-mala-ink hover:bg-mala-gold hover:text-mala-ink font-bold px-7 py-3.5 rounded-full shadow-xl transition-all transform hover:scale-105 flex items-center gap-2"
        >
          <Icon name="bowl" size={20} class="text-mala-red" />
          See Our Menu
        </a>
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="btn bg-emerald-600 text-white hover:bg-emerald-700 font-bold px-7 py-3.5 rounded-full shadow-xl transition-all transform hover:scale-105 flex items-center gap-2"
        >
          <Icon name="whatsapp" size={20} />
          WhatsApp Order
        </a>
        <a
          href="/locations"
          class="btn border-2 border-white/40 text-white hover:bg-white/10 font-bold px-6 py-3.5 rounded-full backdrop-blur-sm transition-all flex items-center gap-2"
        >
          <Icon name="pin" size={18} />
          Directions
        </a>
      </div>

      <!-- Phone Contact Link -->
      <p class="mt-5 text-sm text-gray-300">
        Prefer to call?{' '}
        <a
          href={`tel:${cyberjayaLoc.phoneDisplay.replace(/\s/g, '')}`}
          class="font-bold text-mala-gold hover:underline underline-offset-4"
        >
          {cyberjayaLoc.phoneDisplay}
        </a>
      </p>

      <!-- Trust Bullets Band -->
      <div class="mt-8 border-t border-white/20 pt-6">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {trustBullets.map((bullet) => (
            <li class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-white/95">
              <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-mala-gold text-mala-ink font-extrabold text-xs">
                ✓
              </span>
              <span>{bullet.label}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Gold Border Line -->
  <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-gradient-to-r from-mala-gold via-amber-300 to-mala-gold z-20"></div>
</section>
