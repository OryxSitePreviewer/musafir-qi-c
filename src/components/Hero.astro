---
import { SITE, LABELS, whatsappLink } from '../data/site';
import { INGREDIENT_CLAIM } from '../data/ingredients';
import { LOCATIONS } from '../data/locations';
import Wordmark from './Wordmark.astro';
import OpenStatus from './OpenStatus.astro';
import Icon from './Icon.astro';

const cyberjayaLoc = LOCATIONS[0];
const waHref = whatsappLink(`Hi ${SITE.shortName}, I would like to ask about ordering.`);

const trustBullets = [
  { label: 'No Pork', mark: true },
  { label: 'No Lard', mark: true },
  { label: 'No Cooking Wine', mark: true },
  { label: 'No Alcohol', mark: true },
];

const offerBullets = [
  { label: `${INGREDIENT_CLAIM}+ Fresh Ingredients`, mark: false },
  { label: 'Pay By Weight', mark: false },
];
---

<section class="on-red relative overflow-hidden bg-mala-red text-white">
  <!-- Steam / Shimmer animation background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="steam absolute top-1/4 left-[8%] h-72 w-56 rounded-full bg-white/10 blur-3xl"
      style="animation-delay: 0s;"
    >
    </div>
    <div
      class="steam absolute top-1/3 left-[40%] h-80 w-64 rounded-full bg-mala-gold/15 blur-3xl"
      style="animation-delay: 2.4s;"
    >
    </div>
    <div
      class="steam absolute top-1/4 right-[5%] h-72 w-56 rounded-full bg-white/10 blur-3xl"
      style="animation-delay: 4.6s;"
    >
    </div>
  </div>

  <div class="container-rail relative py-12 sm:py-20 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      
      <!-- Left Column: Prominent Logo, Headline, CTAs, Halal Badges -->
      <div class="lg:col-span-7 animate-fadeInLeft">
        
        <!-- Extra Large Prominent Logo Header Emblem -->
        <div class="mb-6 flex flex-wrap items-center gap-4">
          <Wordmark variant="light" size="xl" class="drop-shadow-2xl" />
        </div>

        <div class="flex flex-wrap items-center gap-3 animate-fadeInUp delay-100">
          <a
            href="#reviews-heading"
            class="inline-flex items-center gap-2 rounded-full bg-black/40 backdrop-blur-md px-4 py-1.5 text-xs font-bold tracking-wide text-white border border-mala-gold/40 hover:border-mala-gold transition-all transform hover:scale-105 shadow-lg"
          >
            <span class="text-mala-gold flex items-center text-sm">★★★★★</span>
            <span class="font-semibold">5.0 Google Rating (12 Reviews)</span>
          </a>
          <span class="h-4 w-px bg-white/30 hidden sm:inline-block"></span>
          <p class="flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-white uppercase">
            <span class="cjk text-lg text-mala-gold">{SITE.chineseName}</span>
            <span>• Cyberjaya, Selangor</span>
          </p>
        </div>

        <!-- Main Display Headline -->
        <h1 class="gold-on-red mt-5 max-w-2xl text-[length:var(--text-display-xl)] leading-tight animate-fadeInUp delay-200">
          <span class="sm:block">Fill your own bowl.</span>{' '}
          <span>Pay for what you took.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-white/95 sm:text-xl leading-relaxed animate-fadeInUp delay-300">
          Walk the ingredient bar, pick whatever you want from over {INGREDIENT_CLAIM} fresh
          ingredients, and we weigh it at the counter. Pay by weight ({SITE.priceRange || 'RM 1–20'}).
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-wrap items-center gap-3 animate-fadeInUp delay-400">
          <a href="/menu" class="btn btn-on-red transform transition-transform hover:scale-105 shadow-lg">
            {LABELS.menu}
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/locations" class="btn btn-ghost-on-red transform transition-transform hover:scale-105">
            <Icon name="pin" size={18} />
            {LABELS.find}
          </a>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-gold transform transition-transform hover:scale-105 shadow-md">
            <Icon name="whatsapp" size={18} />
            WhatsApp Order
          </a>
        </div>

        <!-- Halal & Quality Trust Badges -->
        <div class="mt-10 border-t-2 border-white/20 pt-6 animate-fadeInUp delay-500">
          <h2 class="text-xs font-bold tracking-[0.2em] text-white/90 uppercase">
            Halal Chinese Muslim Kitchen
          </h2>

          <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            {
              trustBullets.map((bullet) => (
                <li class="flex items-center gap-2 text-sm font-semibold text-white sm:text-base">
                  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-mala-green text-white shadow-sm">
                    <Icon name="check" size={13} />
                  </span>
                  {bullet.label}
                </li>
              ))
            }
          </ul>

          <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            {
              offerBullets.map((bullet) => (
                <li class="flex items-center gap-2 text-sm font-semibold text-white sm:text-base">
                  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-mala-gold text-mala-gold">
                    <Icon name="check" size={13} />
                  </span>
                  {bullet.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right Column: Storefront Main Picture Showcase -->
      <div class="lg:col-span-5 animate-fadeInRight delay-200">
        <div class="relative group mx-auto max-w-lg lg:max-w-none">
          <!-- Ambient Glow aura -->
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-mala-gold to-yellow-300 opacity-30 blur-lg transition duration-500 group-hover:opacity-60"></div>
          
          <div class="relative overflow-hidden rounded-2xl border-4 border-mala-gold bg-black shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]">
            <img
              src="/images/outlet-cyberjaya-day.webp"
              alt="Musafir Qi Malatang storefront at CBD Perdana 3 Cyberjaya"
              width="680"
              height="450"
              loading="eager"
              decoding="async"
              class="w-full aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Top Tag: Location -->
            <div class="absolute top-4 left-4 rounded-full bg-black/75 backdrop-blur-md px-3.5 py-1.5 text-xs font-bold text-white border border-white/20 shadow-md">
              📍 Cyberjaya • CBD Perdana 3
            </div>

            <!-- Floating Pill Badge: Storefront Verified -->
            <div class="absolute top-4 right-4 rounded-full bg-mala-gold text-mala-ink px-3 py-1 text-xs font-extrabold shadow-lg animate-pulse-glow">
              ★ 5.0 Google Rated
            </div>

            <!-- Bottom Floating Overlay: Live Hours Status -->
            <div class="absolute bottom-4 left-4 right-4 rounded-xl bg-black/80 backdrop-blur-md p-3.5 border border-white/20 shadow-xl flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-white/80">Storefront Counter</p>
                <p class="text-sm font-bold text-white">10:30 AM to 11:00 PM Daily</p>
              </div>
              <div>
                <OpenStatus location={cyberjayaLoc} />
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Gold rule closing the band. -->
  <div class="h-1.5 w-full bg-gradient-to-r from-mala-gold via-yellow-200 to-mala-gold"></div>
</section>
