---
import { LOCATIONS, directionsLink } from '../data/locations';
import { whatsappLink } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import OpenStatus from './OpenStatus.astro';
import Icon from './Icon.astro';
---

<section class="bg-mala-cream py-16 sm:py-20" aria-labelledby="locations-heading">
  <div class="container-rail">
    <SectionHeading
      id="locations-heading"
      eyebrow="Come in"
      title="Two outlets"
      lede="Both are walk in. No booking, no waiting list. The badge below is live, in Malaysian time."
    />

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        LOCATIONS.map((location) => (
          <li class="reveal card-hard flex flex-col p-6">
            <h3 class="text-[length:var(--text-display-sm)] text-mala-ink">{location.name}</h3>

            <div class="mt-3">
              <OpenStatus location={location} />
            </div>

            <address class="mt-4 flex-1 space-y-3 text-sm not-italic text-mala-ink-soft">
              <p class="flex items-start gap-2">
                <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <span>{location.shortAddress}</span>
              </p>
              <p class="flex items-start gap-2">
                <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <span>{location.hoursDisplay}</span>
              </p>
              <p class="flex items-start gap-2">
                <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <a
                  href={`tel:${location.phoneDisplay.replace(/\s/g, '')}`}
                  class="underline decoration-mala-gold decoration-2 underline-offset-4"
                >
                  {location.phoneDisplay}
                </a>
              </p>
            </address>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href={directionsLink(location)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary btn-sm flex-1"
              >
                <Icon name="directions" size={18} />
                Get directions
              </a>
              <a
                href={whatsappLink(
                  `Hi Dr.MaLa ${location.name}, I would like to ask about ordering.`
                )}
                target="_blank"
                rel="noopener"
                class="btn btn-green btn-sm flex-1"
              >
                <Icon name="whatsapp" size={18} />
                WhatsApp
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8">
      <a href="/locations" class="btn btn-outline">
        Find us
        <Icon name="arrow-right" size={18} />
      </a>
    </p>
  </div>
</section>
