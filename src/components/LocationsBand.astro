---
import { LOCATIONS, directionsLink, wazeLink } from '../data/locations';
import { SITE, whatsappLink } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import OpenStatus from './OpenStatus.astro';
import Icon from './Icon.astro';
---

<section class="bg-mala-cream py-16 sm:py-20" aria-labelledby="locations-heading">
  <div class="container-rail">
    <SectionHeading
      id="locations-heading"
      eyebrow="Come in"
      title="Where to find us"
      lede="Walk in. No booking, no waiting list. The badge below is live, in Malaysian time."
    />

    <!--
      Two columns: the shopfront on the left, the outlet card on the right. There
      is one outlet, so a two-up grid of cards would leave half the row empty. The
      photograph is doing real work here rather than filling a hole, because
      recognising the shopfront from the road is the actual problem a first timer
      has once they have parked at CBD Perdana 3.
    -->
    <div class="mt-10 grid items-start gap-6 md:grid-cols-2">
      <figure class="reveal">
        <img
          src="/images/outlet-cyberjaya-day.webp"
          alt="The Musafir Qi Stesen Mala shopfront at CBD Perdana 3 seen from the corner, with a red sign board, a dark red awning, and roadside tables under it"
          width="680"
          height="383"
          loading="lazy"
          decoding="async"
          class="w-full rounded-sm border-2 border-mala-ink object-cover"
        />
        <figcaption class="mt-2 text-sm text-mala-ink-soft">
          Look for the red board and the awning. The counter runs along the front.
        </figcaption>
      </figure>

      <ul class="grid gap-6">
      {
        LOCATIONS.map((location) => (
          <li class="reveal card-hard flex flex-col p-6">
            <h3 class="text-[length:var(--text-display-sm)] text-mala-ink">{location.name}</h3>

            <div class="mt-3">
              <OpenStatus location={location} />
            </div>

            <address class="mt-4 flex-1 space-y-3 text-sm not-italic text-mala-ink-soft">
              <p class="flex items-start gap-2">
                <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <span>{location.shortAddress}</span>
              </p>
              <p class="flex items-start gap-2">
                <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <span>{location.hoursDisplay}</span>
              </p>
              <p class="flex items-start gap-2">
                <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-mala-red" />
                <a
                  href={`tel:${location.phoneDisplay.replace(/\s/g, '')}`}
                  class="underline decoration-mala-gold decoration-2 underline-offset-4"
                >
                  {location.phoneDisplay}
                </a>
              </p>
            </address>

            <div class="mt-6 flex flex-wrap gap-2">
              <a
                href={directionsLink(location)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary btn-sm flex-1 min-w-[130px]"
              >
                <Icon name="google" size={16} />
                Google Maps
              </a>
              <a
                href={wazeLink(location)}
                target="_blank"
                rel="noopener"
                class="btn bg-cyan-600 hover:bg-cyan-700 text-white btn-sm flex-1 min-w-[110px]"
              >
                <Icon name="waze" size={16} />
                Waze
              </a>
              <a
                href={whatsappLink(
                  `Hi ${SITE.name}, I would like to ask about ordering.`
                )}
                target="_blank"
                rel="noopener"
                class="btn btn-green btn-sm flex-1 min-w-[110px]"
              >
                <Icon name="whatsapp" size={16} />
                WhatsApp
              </a>
            </div>
          </li>
        ))
      }
      </ul>
    </div>

    <p class="mt-8">
      <a href="/locations" class="btn btn-outline">
        Find us
        <Icon name="arrow-right" size={18} />
      </a>
    </p>
  </div>
</section>
