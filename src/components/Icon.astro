  {name === 'plus' && (
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      d="M12 5v14M5 12h14"
    />
  )}
  {name === 'minus' && (
    <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M5 12h14" />
  )}
  {name === 'mail' && (
    <path
      fill="currentColor"
      d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
    />
