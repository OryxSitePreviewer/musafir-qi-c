    />
  )}
  {name === 'waze' && (
    <path
      fill="currentColor"
      d="M12 2C6.48 2 2 6.48 2 12c0 3.32 1.63 6.26 4.14 8.08C6.05 20.37 6 20.68 6 21c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-.21c.64.14 1.31.21 2 .21s1.36-.07 2-.21V21c0 .55.45 1 1 1h2c.55 0 1-.45 1-1 0-.32-.05-.63-.14-.92C18.37 18.26 20 15.32 20 12c0-5.52-4.48-10-10-10zm-3 7.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5S7.5 11.83 7.5 11s.67-1.5 1.5-1.5zm6 0c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zM12 17c-1.8 0-3.3-1.1-3.9-2.7h7.8c-.6 1.6-2.1 2.7-3.9 2.7z"
