  {name === 'bowl' && (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 11h20" />
      <path d="M3.6 11.5v.4a8.4 8.4 0 0 0 16.8 0v-.4" />
      <path d="M9.2 7.6c0-1.6 1.3-2.1 1.3-3.7M14.2 7.6c0-1.9 1.5-2.5 1.5-4.2" />
    </g>
