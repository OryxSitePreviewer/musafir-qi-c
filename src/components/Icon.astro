  {name === 'no-pork' && (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M5.6 5.6l12.8 12.8" />
      <path
        fill="currentColor"
        stroke="none"
        d="M9.2 10.1c.4-.7 1.3-1.2 2.3-1.2h1.6c1.5 0 2.7 1 2.7 2.3v1.4c0 .6-.2 1.1-.6 1.5l-5.8-4c-.1 0-.2 0 0 0Z"
