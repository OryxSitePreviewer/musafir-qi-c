      fill="currentColor"
      d="M20 3s-9-1-13 3c-3 3-3 8 0 11l1.5-1.5C6 12 9 8 15 7c-4 2-7 5-8 9.5l1.5 1.5C13 18 20 14 20 3Z"
    />
