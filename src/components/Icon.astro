  {name === 'scale' && (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v16M7 20h10M3 9h18" />
      <path d="M6.5 9 3 16h7l-3.5-7ZM17.5 9 14 16h7l-3.5-7Z" />
