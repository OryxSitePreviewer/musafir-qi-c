---
import { SITE, LABELS, whatsappLink } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  /** One line. Say the thing, do not sell it. */
  line?: string;
  message?: string;
}

const {
  line = 'Bring an appetite and a plan for how much noodle you can handle.',
  message = `Hi ${SITE.shortName}, I would like to ask about ordering.`,
} = Astro.props;
---

<section class="on-red bg-mala-red py-14 text-white sm:py-16">
  <div class="container-rail flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <p class="gold-on-red max-w-2xl text-[length:var(--text-display-md)]" style="font-family: var(--font-display); text-transform: uppercase; line-height: 0.95;">
      {line}
    </p>
    <a href={whatsappLink(message)} target="_blank" rel="noopener" class="btn btn-gold shrink-0">
      <Icon name="whatsapp" size={20} />
      {LABELS.whatsapp}
    </a>
  </div>
</section>
