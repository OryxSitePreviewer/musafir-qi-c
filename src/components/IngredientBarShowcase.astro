---
import { INGREDIENT_CATEGORIES, INGREDIENT_CLAIM } from '../data/ingredients';

/**
 * The ingredient bar band. A lead photo with one stat overlaid, then two tiles.
 *
 * The lead image is 3:2 rather than 16:9 because every photograph we have is a
 * portrait phone shot. A 16:9 crop of a portrait frame throws away most of the
 * picture. Restore the 16:9 lead once a proper wide shot of the bar exists.
 * See public/images/README.md.
 */
const shots = [
  {
    src: '/images/bar-trays.webp',
    alt: 'Steel trays on the counter holding prepared dishes, including stir fried cabbage, sliced beef with peppers, and scrambled egg with tomato',
    width: 500,
    height: 333,
  },
  {
    src: '/images/dish-skewers.webp',
    alt: 'Charcoal grilled skewers of marinated lamb and sweetcorn dusted with chilli and cumin, resting on a black tray',
    width: 500,
    height: 375,
  },
  {
    src: '/images/bowls-table.webp',
    alt: 'Five bowls of mala soup with noodles, fishballs, and vegetables set out on a marble table',
    width: 480,
    height: 360,
  },
];
---

<section class="bg-white py-16 sm:py-20" aria-labelledby="bar-heading">
  <div class="container-rail">
    <h2 id="bar-heading" class="sr-only">The ingredient bar</h2>

    <div class="reveal relative">
      <img
        src={shots[0]!.src}
        alt={shots[0]!.alt}
        width={shots[0]!.width}
        height={shots[0]!.height}
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full rounded-sm border-2 border-mala-ink object-cover"
      />

      <!-- The single stat. Gold display type at 40px and up, which clears the
           minimum size for gold on a dark surface. -->
      <div
        class="absolute right-3 bottom-3 left-3 border-l-4 border-mala-gold bg-mala-ink p-4 sm:right-auto sm:bottom-6 sm:left-6 sm:max-w-sm sm:p-6"
      >
        <p class="text-[clamp(2.5rem,5vw,3.5rem)] leading-none text-mala-gold">
          {INGREDIENT_CLAIM}+ ingredients
        </p>
        <p class="mt-2 text-sm font-semibold text-white">Restocked daily.</p>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        shots.slice(1).map((shot) => (
          <img
            src={shot.src}
            alt={shot.alt}
            width={shot.width}
            height={shot.height}
            loading="lazy"
            decoding="async"
            class="reveal aspect-[4/3] w-full rounded-sm border-2 border-mala-ink object-cover"
          />
        ))
      }
    </div>

    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-mala-ink-soft">
      {
        INGREDIENT_CATEGORIES.map((category) => (
          <li class="flex items-center gap-2">
            <span
              class="inline-block h-2.5 w-2.5 rounded-full"
              style={`background-color: var(--mala-${category.color === 'ink' ? 'ink' : category.color});`}
            />
            {category.heading}
            <span class="tnum text-mala-ink-soft">{category.items.length}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
