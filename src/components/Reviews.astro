---
/**
 * Google reviews band.
 *
 * Three states, and the component picks whichever the data supports:
 *   1. Rating and quotes    -> stars, count, and the quote cards
 *   2. Rating, no quotes    -> stars and count, then the link out
 *   3. Neither              -> a direct invitation to read them on Google
 *
 * State 3 is the shipping state, and it is not a failure. It gives the visitor
 * somewhere to go rather than apologising for an empty section. Nothing here is
 * ever invented. See the notes in src/data/reviews.ts.
 */

import { REVIEWS } from '../data/reviews';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const hasRating = typeof REVIEWS.rating === 'number' && REVIEWS.rating > 0;
const hasQuotes = REVIEWS.featured.length > 0;

/** Fills whole, half, and empty stars for a rating out of five. */
function starFill(index: number, rating: number): 'full' | 'half' | 'empty' {
  if (rating >= index + 1) return 'full';
  if (rating >= index + 0.5) return 'half';
  return 'empty';
}
---

<section class="bg-white py-16 sm:py-20" aria-labelledby="reviews-heading">
  <div class="container-rail">
    <SectionHeading
      id="reviews-heading"
      eyebrow={REVIEWS.eyebrow}
      title={REVIEWS.heading}
      lede={
        hasRating
          ? 'Every review below sits on our Google listing, where you can read all of them unedited.'
          : 'We do not reprint reviews here. Read them on Google, where they are unedited and you can see who wrote them.'
      }
    />

    <div class="reveal mt-10 card-hard p-6 sm:p-8">
      {
        hasRating && (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <span
              class="flex items-center gap-1"
              role="img"
              aria-label={`Rated ${REVIEWS.rating} out of 5 on Google`}
            >
              {Array.from({ length: 5 }).map((_, index) => {
                const fill = starFill(index, REVIEWS.rating as number);
                return (
                  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
                    <defs>
                      <linearGradient id={`star-${index}`}>
                        <stop offset="50%" stop-color="var(--mala-gold)" />
                        <stop offset="50%" stop-color="transparent" />
                      </linearGradient>
                    </defs>
                    <path
                      d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z"
                      fill={
                        fill === 'full'
                          ? 'var(--mala-gold)'
                          : fill === 'half'
                            ? `url(#star-${index})`
                            : 'transparent'
                      }
                      stroke="var(--mala-gold)"
                      stroke-width="1.6"
                      stroke-linejoin="round"
                    />
                  </svg>
                );
              })}
            </span>

            <p class="tnum text-[length:var(--text-display-sm)] text-mala-ink">
              {REVIEWS.rating} out of 5
            </p>

            {REVIEWS.count && (
              <p class="tnum text-sm font-semibold text-mala-ink-soft">
                {REVIEWS.count} Google reviews
              </p>
            )}
          </div>
        )
      }

      {
        hasQuotes && (
          <ul class="mt-8 grid gap-5 md:grid-cols-3">
            {REVIEWS.featured.map((review) => (
              <li class="rounded-sm border-2 border-black/15 p-5">
                <span
                  class="flex items-center gap-0.5"
                  role="img"
                  aria-label={`${review.rating} out of 5`}
                >
                  {Array.from({ length: 5 }).map((_, index) => (
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                      <path
                        d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z"
                        fill={index < review.rating ? 'var(--mala-gold)' : 'transparent'}
                        stroke="var(--mala-gold)"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ))}
                </span>
                <blockquote class="mt-3 text-sm text-mala-ink">
                  <p>{review.quote}</p>
                </blockquote>
                <p class="mt-3 text-xs font-semibold tracking-wider text-mala-ink-soft uppercase">
                  {review.name}, {review.when}
                </p>
              </li>
            ))}
          </ul>
        )
      }

      {
        !hasRating && (
          <p class="max-w-2xl text-base text-mala-ink-soft">
            Our Google listing carries the reviews, the photographs customers have taken, and
            the current opening hours. Read them there rather than take our word for it here.
          </p>
        )
      }

      <div class="mt-8 flex flex-col gap-3 border-t-2 border-black/10 pt-6 sm:flex-row sm:flex-wrap">
        <a href={REVIEWS.reviewsUrl} target="_blank" rel="noopener" class="btn btn-primary">
          Read reviews on Google
          <Icon name="arrow-right" size={18} />
        </a>
        <a href={REVIEWS.writeReviewUrl} target="_blank" rel="noopener" class="btn btn-outline">
          Leave a review
        </a>
      </div>
    </div>
  </div>
</section>
