---
import { REVIEWS } from '../data/reviews';
import { SITE } from '../data/site';
import { LOCATIONS, wazeLink } from '../data/locations';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const cyberjayaLoc = LOCATIONS[0];
const wazeNavUrl = wazeLink(cyberjayaLoc);

function getInitials(name: string) {
  return name.split(' ').map((n) => n[0]).join('').toUpperCase();
}
---

<section class="bg-white py-16 sm:py-20" aria-labelledby="reviews-heading">
  <div class="container-rail">
    <SectionHeading
      id="reviews-heading"
      eyebrow={REVIEWS.eyebrow}
      title={REVIEWS.heading}
      lede="Read verified reviews from real diners directly on our official Google Business Listing."
    />

    <!-- Google Business Profile Card Widget -->
    <div class="reveal mt-10 rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between border-b border-gray-100 pb-6">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-gray-50 border border-gray-200 shadow-sm text-2xl font-bold text-mala-red">
            <Icon name="google" size={28} />
          </div>

          <div>
            <div class="flex items-center gap-2">
              <span class="rounded bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700">Google Business</span>
              <span class="text-xs font-medium text-gray-500">Verified Profile</span>
            </div>
            <h3 class="mt-1 text-xl font-bold text-gray-900 sm:text-2xl">
              {SITE.officialListingName || 'Musafir China Muslim BBQ& Hot Pot&Malatang'}
            </h3>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <div class="flex items-center gap-1">
                <span class="text-lg font-extrabold text-gray-900 tnum">5.0</span>
                <div class="flex text-amber-400">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>
              <a
                href={REVIEWS.reviewsUrl}
                target="_blank"
                rel="noopener"
                class="text-sm font-semibold text-blue-600 hover:underline"
              >
                12 Google reviews
              </a>
              <span class="text-gray-300">•</span>
              <span class="text-sm font-medium text-gray-600">RM 1–20 · Restaurant</span>
            </div>
          </div>
        </div>

        <!-- Google Business Quick Navigation Buttons -->
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={REVIEWS.reviewsUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-all hover:bg-gray-50 hover:border-gray-400"
          >
            <Icon name="directions" size={16} class="text-blue-600" />
            Directions
          </a>
          <a
            href={wazeNavUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-cyan-300 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-800 shadow-sm transition-all hover:bg-cyan-100"
          >
            <Icon name="waze" size={16} class="text-cyan-600" />
            Waze
          </a>
          <a
            href={REVIEWS.writeReviewUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-all hover:bg-gray-50"
          >
            Reviews
          </a>
        </div>
      </div>

      <!-- Reviews Grid -->
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {REVIEWS.featured.map((review) => (
          <div class="flex flex-col justify-between rounded-xl border border-gray-100 bg-gray-50/80 p-5 transition-shadow hover:shadow-md">
            <div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-mala-red text-xs font-bold text-white shadow-sm">
                    {getInitials(review.name)}
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-gray-900">{review.name}</h4>
                    <p class="text-[11px] font-medium text-gray-500">{review.when}</p>
                  </div>
                </div>
                <div class="flex text-amber-400">
                  {Array.from({ length: review.rating }).map(() => (
                    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-gray-700 italic">
                "{review.quote}"
              </p>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-[11px] font-medium text-emerald-600">
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Verified Google Review</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Action Footer -->
      <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-gray-100 pt-6 sm:flex-row">
        <p class="text-xs text-gray-500">
          Showing 5.0 rating from verified Google customer reviews.
        </p>
        <div class="flex gap-3">
          <a
            href={REVIEWS.reviewsUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-primary btn-sm"
          >
            <Icon name="google" size={16} />
            Read all 12 reviews on Google
          </a>
          <a
            href={REVIEWS.writeReviewUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-outline btn-sm"
          >
            Leave a review
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
