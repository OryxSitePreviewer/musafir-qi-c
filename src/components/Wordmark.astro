---
/**
 * The brand lockup: the real Musafir Qi badge, then STESEN MALA set beside it.
 *
 * This mirrors how the shopfront sign is laid out. The badge carries "Musafir Qi",
 * the outlet name sits under it, and the three things the shop sells run below that.
 *
 * The badge is the supplied artwork at public/images/logo-musafir-qi.png, built from
 * the master in src/assets/brand/ by `npm run images`. It is 332px wide, which is
 * about 2.5x the largest size it is ever displayed at, so it stays sharp on a
 * retina screen. If a vector version turns up, drop it in src/assets/brand/ and
 * point the BRAND table in scripts/process-photos.mjs at it.
 */

import { SITE } from '../data/site';

interface Props {
  /** 'light' sits on a red or dark band. 'dark' sits on white or cream. */
  variant?: 'light' | 'dark';
  class?: string;
  /** Renders an h1-adjacent large lockup instead of the compact header size. */
  size?: 'sm' | 'lg';
  /**
   * Drops the sign line on narrow screens. The header needs this because it also
   * has to fit a 44px menu button. The footer does not, because it has a column
   * to itself.
   */
  compact?: boolean;
}

const { variant = 'light', class: className = '', size = 'sm', compact = false } = Astro.props;

// Reads from the shared property so the contrast switch documented in
// global.css covers the lockup as well as the headlines.
const nameColor = variant === 'light' ? 'var(--mala-gold-on-red)' : 'var(--mala-red)';
const subColor = variant === 'light' ? 'var(--mala-white)' : 'var(--color-mala-ink-soft, #4a3d3b)';

---

<span
  class={`wordmark inline-flex items-center gap-2.5 ${className}`}
  data-size={size}
  data-compact={compact ? "true" : undefined}
>
  <img
    src="/images/logo-musafir-qi.png"
    alt=""
    width="332"
    height="115"
    decoding="async"
    class="wordmark-badge shrink-0"
  />

  <span class="flex min-w-0 flex-col leading-none">
    <span class="wordmark-name uppercase leading-none" style={`color: ${nameColor};`}>
      {SITE.shortName}
    </span>
    <span class="wordmark-sub mt-1 font-semibold uppercase leading-none" style={`color: ${subColor};`}>
      {SITE.signBoard}
    </span>
  </span>
</span>

<style>
  /* The badge is 332x115, so height drives it and width follows the ratio. */
  .wordmark-badge {
    height: 1.875rem;
    width: auto;
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  /* The sign line is the longest part of the lockup, and on a 320px phone it is
     what pushes the menu button off the edge. It starts small and tight, then
     opens up once there is room. Measured against the 44px menu button plus the
     container padding, so the two never collide. */
  .wordmark-sub {
    font-size: 0.5rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (min-width: 420px) {
    .wordmark-badge {
      height: 2.125rem;
    }

    .wordmark-name {
      font-size: 1.5rem;
    }

    .wordmark-sub {
      font-size: 0.5625rem;
      letter-spacing: 0.06em;
    }
  }

  @media (min-width: 640px) {
    .wordmark-sub {
      letter-spacing: 0.12em;
    }
  }

  /* At 320px the badge, the name, the sign line, and a 44px menu button cannot
     all fit on one row. The sign line is the part that gives way, because it also
     appears in the footer and in the hero. */
  .wordmark[data-compact='true'] .wordmark-sub {
    display: none;
  }

  @media (min-width: 420px) {
    .wordmark[data-compact='true'] .wordmark-sub {
      display: block;
    }
  }

  /* The large lockup is only ever used where it has a column to itself. */
  .wordmark[data-size='lg'] .wordmark-badge {
    height: 3rem;
  }

  .wordmark[data-size='lg'] .wordmark-name {
    font-size: 2.5rem;
  }

  .wordmark[data-size='lg'] .wordmark-sub {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }
</style>
