---
/**
 * The brand lockup: the real Musafir Qi badge, then STESEN MALA set beside it.
 *
 * This mirrors how the shopfront sign is laid out. The badge carries "Musafir Qi",
 * the outlet name sits under it, and the three things the shop sells run below that.
 *
 * The badge is the supplied artwork at public/images/logo-musafir-qi.png, built from
 * the master in src/assets/brand/ by `npm run images`. It is 332px wide, which is
 * about 2.5x the largest size it is ever displayed at, so it stays sharp on a
 * retina screen. If a vector version turns up, drop it in src/assets/brand/ and
 * point the BRAND table in scripts/process-photos.mjs at it.
 */

import { SITE } from '../data/site';

interface Props {
  /** 'light' sits on a red or dark band. 'dark' sits on white or cream. */
  variant?: 'light' | 'dark';
  class?: string;
  /** Renders a standard, large, or extra-large brand emblem lockup. */
  size?: 'sm' | 'lg' | 'xl';
  /**
   * Drops the sign line on narrow screens.
   */
  compact?: boolean;
}

const { variant = 'light', class: className = '', size = 'sm', compact = false } = Astro.props;

// Reads from the shared property so the contrast switch documented in
// global.css covers the lockup as well as the headlines.
const nameColor = variant === 'light' ? 'var(--mala-gold-on-red)' : 'var(--mala-red)';
const subColor = variant === 'light' ? 'var(--mala-white)' : 'var(--color-mala-ink-soft, #4a3d3b)';

---

<span
  class={`wordmark inline-flex items-center gap-3.5 ${className}`}
  data-size={size}
  data-compact={compact ? "true" : undefined}
>
  <img
    src="/images/logo-musafir-qi.png"
    alt=""
    width="332"
    height="115"
    decoding="async"
    class="wordmark-badge shrink-0"
  />

  <span class="flex min-w-0 flex-col leading-none">
    <span class="wordmark-name uppercase leading-none" style={`color: ${nameColor};`}>
      {SITE.shortName}
    </span>
    <span class="wordmark-sub mt-1 font-semibold uppercase leading-none" style={`color: ${subColor};`}>
      {SITE.signBoard}
    </span>
  </span>
</span>

<style>
  /* Standard header logo styling: sleek, crisp, perfectly proportioned */
  .wordmark-badge {
    height: 2.125rem;
    width: auto;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
    transition: transform 0.2s ease;
  }

  .wordmark:hover .wordmark-badge {
    transform: scale(1.04);
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .wordmark-sub {
    font-size: 0.525rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.9;
  }

  @media (min-width: 420px) {
    .wordmark-badge {
      height: 2.375rem;
    }

    .wordmark-name {
      font-size: 1.5rem;
    }

    .wordmark-sub {
      font-size: 0.575rem;
      letter-spacing: 0.06em;
    }
  }

  @media (min-width: 640px) {
    .wordmark-badge {
      height: 2.625rem;
    }

    .wordmark-name {
      font-size: 1.65rem;
    }

    .wordmark-sub {
      letter-spacing: 0.1em;
    }
  }

  .wordmark[data-compact='true'] .wordmark-sub {
    display: none;
  }

  @media (min-width: 420px) {
    .wordmark[data-compact='true'] .wordmark-sub {
      display: block;
    }
  }

  /* Large emblem lockup for footer or standalone cards */
  .wordmark[data-size='lg'] .wordmark-badge {
    height: 3.75rem;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
  }

  .wordmark[data-size='lg'] .wordmark-name {
    font-size: 2.5rem;
  }

  .wordmark[data-size='lg'] .wordmark-sub {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  /* XL Extra Large emblem lockup */
  .wordmark[data-size='xl'] .wordmark-badge {
    height: 4.75rem;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.4));
  }

  .wordmark[data-size='xl'] .wordmark-name {
    font-size: 3.25rem;
  }

  .wordmark[data-size='xl'] .wordmark-sub {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
  }
</style>
