---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SpiceMeter from '../components/SpiceMeter.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

import { STEPS, FIRST_TIMER_GUIDE } from '../data/steps';
import { SPICE_LEVELS, SOUP_BASES } from '../data/dishes';
import { PRICE_PER_100G, CURRENCY, PORTION_GUIDE, formatPrice } from '../data/pricing';
import { INGREDIENT_CLAIM } from '../data/ingredients';
import { allRestaurantsSchema, breadcrumbSchema } from '../lib/schema';

const schemas = [
  ...allRestaurantsSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'How It Works', path: '/how-it-works' },
  ]),
];

/** Worked example so the price stops being abstract. */
const sampleBowl = [
  { name: 'Hand Pulled Noodle', grams: 90 },
  { name: 'Sliced Beef Roll x3', grams: 75 },
  { name: 'Beef Meatball x2', grams: 36 },
  { name: 'Fish Tofu x2', grams: 40 },
  { name: 'Tofu Puff x4', grams: 32 },
  { name: 'Baby Bok Choy', grams: 45 },
  { name: 'Enoki Mushroom', grams: 45 },
  { name: 'Corn on the Cob', grams: 60 },
];
const sampleTotal = sampleBowl.reduce((sum, row) => sum + row.grams, 0);
const samplePrice = (sampleTotal / 100) * PRICE_PER_100G;
---

<Base
  title="How It Works"
  description="How pick and weigh malatang works at Musafir Qi Stesen Mala. Take a bowl, fill it from the bar, pick your soup and spice level, then weigh and pay. Includes a first timer guide."
  path="/how-it-works"
  schemas={schemas}
>
  <section class="on-red bg-mala-red py-14 text-white sm:py-20">
    <div class="container-rail">
      <p class="text-xs font-bold tracking-[0.2em] text-white uppercase">Nobody explains this</p>
      <h1 class="gold-on-red mt-3 max-w-3xl text-[length:var(--text-display-lg)]">
        How it works
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white">
        Four steps. Read this once and you will walk in knowing exactly what to do.
      </p>
    </div>
    <div class="h-1 w-full bg-mala-gold"></div>
  </section>

  <!-- The four steps, expanded -->
  <section class="bg-white py-16 sm:py-20" aria-labelledby="steps-heading">
    <div class="container-rail">
      <SectionHeading
        id="steps-heading"
        eyebrow="The sequence"
        title="Four steps"
        lede="The order matters. Do them out of order and you will end up holding a full bowl at the wrong end of the counter."
      />

      <ol class="mt-10 space-y-6">
        {
          STEPS.map((step) => (
            <li class="reveal card-hard p-6 sm:p-8">
              <div class="flex flex-col gap-6 sm:flex-row">
                <div class="flex shrink-0 items-start gap-4">
                  <span
                    class="text-[4rem] leading-none text-mala-red sm:text-[5rem]"
                    style="font-family: var(--font-display);"
                    aria-hidden="true"
                  >
                    {String(step.number).padStart(2, '0')}
                  </span>
                  <Icon name={step.icon} size={36} class="mt-2 text-mala-gold sm:mt-4" />
                </div>

                <div class="flex-1">
                  <h2 class="text-[length:var(--text-display-sm)] text-mala-ink">
                    <span class="sr-only">{`Step ${step.number}. `}</span>
                    {step.title}
                  </h2>
                  <p class="mt-3 text-mala-ink-soft">{step.detail}</p>

                  <ul class="mt-5 space-y-2">
                    {step.tips.map((tip) => (
                      <li class="flex gap-3 text-sm">
                        <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-mala-gold" />
                        <span>{tip}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Worked example -->
  <section class="bg-mala-cream py-16 sm:py-20" aria-labelledby="example-heading">
    <div class="container-rail">
      <SectionHeading
        id="example-heading"
        eyebrow="What it actually costs"
        title="A normal bowl, priced"
        lede="This is a real single portion for an adult with a normal appetite. Nothing exotic and nothing left out."
      />

      <div class="mt-10 grid gap-6 lg:grid-cols-[24rem_1fr] lg:items-start">
        <div class="card-hard overflow-hidden">
          <h3 class="border-b-2 border-mala-ink bg-mala-ink px-5 py-3 text-[1.25rem] text-mala-gold">
            One bowl
          </h3>
          <ul class="p-5">
            {
              sampleBowl.map((row) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-black/10 py-2">
                  <span class="text-sm font-semibold">{row.name}</span>
                  <span class="tnum shrink-0 text-sm text-mala-ink-soft">{row.grams} g</span>
                </li>
              ))
            }
            <li class="flex items-baseline justify-between gap-3 border-t-2 border-mala-ink pt-3 pb-1">
              <span class="text-sm font-bold tracking-widest uppercase">Weight</span>
              <span class="tnum text-lg font-bold">{sampleTotal} g</span>
            </li>
            <li class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-bold tracking-widest uppercase">You pay</span>
              <span class="tnum text-[1.75rem] font-bold text-mala-red">
                {formatPrice(samplePrice)}
              </span>
            </li>
          </ul>
          <p class="border-t-2 border-black/10 px-5 py-3 text-xs text-mala-ink-soft">
            At {CURRENCY} {PRICE_PER_100G.toFixed(2)} per 100 g. Soup base included.
          </p>
        </div>

        <div class="space-y-5">
          <div class="card-hard p-6">
            <h3 class="text-[1.375rem]">Read the weight, not the pieces</h3>
            <p class="mt-3 text-mala-ink-soft">
              Six tofu puffs weigh less than one portion of udon. If you want a big bowl for less
              money, load up on vegetables, tofu puffs, and bean curd skin, and take one light
              noodle. If you want it cheap and filling, take the noodle and go easy on the sliced
              meat.
            </p>
          </div>

          <div class="card-hard p-6">
            <h3 class="text-[1.375rem]">Where the weight actually sits</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between gap-3 border-b border-black/10 pb-2">
                <span>Udon, one portion</span>
                <span class="tnum font-semibold">100 g</span>
              </li>
              <li class="flex justify-between gap-3 border-b border-black/10 pb-2">
                <span>Corn on the cob, one piece</span>
                <span class="tnum font-semibold">60 g</span>
              </li>
              <li class="flex justify-between gap-3 border-b border-black/10 pb-2">
                <span>Beef meatball, one piece</span>
                <span class="tnum font-semibold">18 g</span>
              </li>
              <li class="flex justify-between gap-3">
                <span>Tofu puff, one piece</span>
                <span class="tnum font-semibold">8 g</span>
              </li>
            </ul>
          </div>

          <p>
            <a href="/#build-your-bowl" class="btn btn-primary">
              Estimate your own bowl
              <Icon name="arrow-right" size={18} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- First timer guide -->
  <section class="bg-white py-16 sm:py-20" aria-labelledby="guide-heading">
    <div class="container-rail">
      <SectionHeading
        id="guide-heading"
        eyebrow="First time"
        title="A guide for your first visit"
        lede={`Over ${INGREDIENT_CLAIM} things on the bar is a lot to face cold. Here is where to start.`}
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          FIRST_TIMER_GUIDE.map((topic) => (
            <article class="reveal card-hard p-6">
              <h3 class="text-[1.375rem] text-mala-ink">{topic.heading}</h3>
              <p class="mt-3 text-mala-ink-soft">{topic.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Portion reference -->
      <div class="mt-8 card-hard border-l-[6px] border-l-mala-gold p-6">
        <h3 class="text-[1.375rem]">Portion reference</h3>
        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="text-sm font-semibold text-mala-ink-soft">Light bowl</dt>
            <dd class="tnum text-xl font-bold">
              Under {PORTION_GUIDE.light} g
              <span class="block text-sm font-normal text-mala-ink-soft">
                About {formatPrice((PORTION_GUIDE.light / 100) * PRICE_PER_100G)}
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-mala-ink-soft">Normal bowl</dt>
            <dd class="tnum text-xl font-bold">
              Around {PORTION_GUIDE.typical} g
              <span class="block text-sm font-normal text-mala-ink-soft">
                About {formatPrice((PORTION_GUIDE.typical / 100) * PRICE_PER_100G)}
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-mala-ink-soft">Big bowl</dt>
            <dd class="tnum text-xl font-bold">
              Over {PORTION_GUIDE.large} g
              <span class="block text-sm font-normal text-mala-ink-soft">
                About {formatPrice((PORTION_GUIDE.large / 100) * PRICE_PER_100G)}
              </span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Spice levels -->
  <section class="bg-mala-ink py-16 text-white sm:py-20" aria-labelledby="spice-heading">
    <div class="container-rail">
      <SectionHeading
        id="spice-heading"
        eyebrow="The number you say"
        title="What the spice levels mean"
        lede="Mala is two things at once. Chilli brings heat, Sichuan peppercorn brings a numbing tingle. The level sets both."
        tone="light"
      />

      <ol class="mt-10 space-y-3">
        {
          SPICE_LEVELS.map((level) => (
            <li class="reveal flex flex-col gap-3 rounded-sm border-2 border-white/20 bg-white/5 p-5 sm:flex-row sm:items-start sm:gap-6">
              <div class="flex shrink-0 items-center gap-3 sm:w-40">
                <span class="text-[2.5rem] leading-none text-mala-gold" style="font-family: var(--font-display);">
                  {level.level}
                </span>
                <div>
                  <p class="font-bold">{level.name}</p>
                  <p class="cjk text-sm text-white/60">{level.chineseName}</p>
                </div>
              </div>
              <p class="flex-1 text-sm text-white/80">{level.meaning}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 rounded-sm border-2 border-mala-gold p-5">
        <h3 class="text-[1.25rem] text-mala-gold">Which base to start with</h3>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            SOUP_BASES.filter((base) => base.id === 'mala' || base.id === 'collagen').map(
              (base) => (
                <li>
                  <p class="font-bold text-white">{base.name}</p>
                  <div class="mt-2">
                    <SpiceMeter level={base.spice} tone="light" />
                  </div>
                  <p class="mt-2 text-sm text-white/75">{base.taste}</p>
                </li>
              )
            )
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand line="Still not sure? Ask us before you come." />
</Base>
