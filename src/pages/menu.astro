---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SpiceMeter from '../components/SpiceMeter.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

import { INGREDIENT_CATEGORIES, INGREDIENT_COUNT } from '../data/ingredients';
import {
  SOUP_BASES,
  SOUP_ONLY_BASES,
  SPICE_LEVELS,
  ADD_ON_GROUPS,
} from '../data/dishes';
import { PRICE_PER_100G, CURRENCY, formatPrice, PORTION_GUIDE } from '../data/pricing';
import { SITE } from '../data/site';
import { LOCATIONS } from '../data/locations';
import { allRestaurantsSchema, breadcrumbSchema } from '../lib/schema';

const schemas = [
  ...allRestaurantsSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Menu and Ingredients', path: '/menu' },
  ]),
];

const typicalBowl = (PORTION_GUIDE.typical / 100) * PRICE_PER_100G;

const COLOR_VAR = {
  red: 'var(--mala-red)',
  green: 'var(--mala-green)',
  gold: 'var(--mala-gold)',
  ink: 'var(--mala-ink)',
  blue: 'var(--mala-blue)',
} as const;
---

<Base
  title="Menu and Ingredients"
  description={`Every ingredient on the Musafir Qi Stesen Mala bar with average weights, all soup bases and spice levels, and sides and drinks. ${CURRENCY} ${PRICE_PER_100G.toFixed(2)} per 100 grams.`}
  path="/menu"
  schemas={schemas}
>
  <!-- Page header -->
  <section class="on-red bg-mala-red py-14 text-white sm:py-20">
    <div class="container-rail">
      <p class="text-xs font-bold tracking-[0.2em] text-white uppercase">The full list</p>
      <h1 class="gold-on-red mt-3 max-w-3xl text-[length:var(--text-display-lg)]">
        Menu and ingredients
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white">
        {INGREDIENT_COUNT} ingredients across {INGREDIENT_CATEGORIES.length} sections, {
          SOUP_ONLY_BASES.length
        } soup bases, and {SPICE_LEVELS.length} spice levels. You take what you want and pay by weight.
      </p>

      <div
        class="mt-8 inline-flex flex-wrap items-center gap-x-8 gap-y-4 rounded-sm border-2 border-mala-gold px-5 py-4"
      >
        <div>
          <p class="text-xs font-semibold tracking-widest text-white uppercase">Price</p>
          <p class="tnum text-2xl font-bold text-white">
            {`${CURRENCY} ${PRICE_PER_100G.toFixed(2)} `}
            <span class="text-base font-normal">per 100 g</span>
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-widest text-white uppercase">
            A typical single bowl
          </p>
          <p class="tnum text-2xl font-bold text-white">
            {`About ${formatPrice(typicalBowl)} `}
            <span class="text-base font-normal">at {PORTION_GUIDE.typical} g</span>
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/#build-your-bowl" class="btn btn-on-red">Estimate your bowl</a>
        <button type="button" id="print-menu" class="btn btn-ghost-on-red no-print">
          <Icon name="print" size={18} />
          Print this menu
        </button>
      </div>
    </div>
    <div class="h-1 w-full bg-mala-gold"></div>
  </section>

  <!-- Print only header, because the red band does not print -->
  <div class="print-only container-rail pt-4">
    <p class="text-lg font-bold">{SITE.name} ({SITE.shortName})</p>
    <p class="text-sm">
      {CURRENCY} {PRICE_PER_100G.toFixed(2)} per 100 g. Weighed at the counter.
    </p>
    <p class="text-sm">
      {LOCATIONS.map((location) => location.shortAddress).join('  |  ')}
    </p>
  </div>

  <!-- Soup bases -->
  <section id="soup-bases" class="bg-white py-16 sm:py-20" aria-labelledby="bases-heading">
    <div class="container-rail">
      <SectionHeading
        id="bases-heading"
        eyebrow="Step three at the counter"
        title="Soup bases"
        lede="One base comes with every bowl. Name it when you hand your bowl over."
      />

      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {
          SOUP_BASES.map((base) => (
            <li class="print-block card-hard flex gap-4 p-5">
              <div class="flex-1">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-[1.375rem] text-mala-ink">{base.name}</h3>
                  {base.chineseName && (
                    <span class="cjk text-sm text-mala-ink-soft">{base.chineseName}</span>
                  )}
                </div>
                {base.badge && (
                  <span class="mt-2 inline-block rounded-sm border-2 border-mala-gold px-2 py-0.5 text-[0.625rem] font-bold tracking-widest uppercase">
                    {base.badge}
                  </span>
                )}
                <p class="mt-3 text-sm text-mala-ink-soft">{base.taste}</p>
                <div class="mt-4">
                  <SpiceMeter level={base.spice} />
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Spice levels -->
  <section id="spice" class="bg-mala-ink py-16 text-white sm:py-20" aria-labelledby="spice-heading">
    <div class="container-rail">
      <SectionHeading
        id="spice-heading"
        eyebrow="Say a number"
        title="Spice levels"
        lede="This applies to the mala base and the mala stir-fry. Set it before cooking, because it cannot be changed after."
        tone="light"
      />

      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          SPICE_LEVELS.map((level) => (
            <li class="print-block rounded-sm border-2 border-white/20 bg-white/5 p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="text-[2.5rem] leading-none text-mala-gold" style="font-family: var(--font-display);">
                  {level.level}
                </span>
                <span class="cjk text-lg text-white/70">{level.chineseName}</span>
              </div>
              <h3 class="mt-2 text-[1.25rem] text-white">{level.name}</h3>
              <p class="mt-2 text-sm text-white/75">{level.meaning}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Ingredients -->
  <section id="ingredients" class="bg-mala-cream py-16 sm:py-20" aria-labelledby="ingredients-heading">
    <div class="container-rail">
      <SectionHeading
        id="ingredients-heading"
        eyebrow="The bar"
        title="Every ingredient"
        lede="Average weight per piece is listed so you can work out roughly what your bowl will come to before you get to the scale."
      />

      <nav class="mt-8 no-print" aria-label="Jump to ingredient category">
        <ul class="flex flex-wrap gap-2">
          {
            INGREDIENT_CATEGORIES.map((category) => (
              <li>
                <a
                  href={`#category-${category.id}`}
                  class="inline-flex items-center gap-2 rounded-sm border-2 border-black/20 bg-white px-3 py-2 text-sm font-semibold transition-colors hover:border-mala-ink"
                >
                  <span
                    class="inline-block h-2.5 w-2.5 rounded-full"
                    style={`background-color: ${COLOR_VAR[category.color]};`}
                  />
                  {category.heading}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-10 space-y-10">
        {
          INGREDIENT_CATEGORIES.map((category) => (
            <div id={`category-${category.id}`} class="print-block scroll-mt-28">
              <div
                class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b-4 pb-3"
                style={`border-color: ${COLOR_VAR[category.color]};`}
              >
                <h3 class="text-[length:var(--text-display-sm)] text-mala-ink">
                  {category.heading}
                </h3>
                <span class="tnum text-sm font-semibold text-mala-ink-soft">
                  {category.items.length} items
                </span>
              </div>
              <p class="mt-3 text-sm text-mala-ink-soft">{category.blurb}</p>

              <ul class="mt-5 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
                {category.items.map((item) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-black/10 py-2">
                    <span class="text-sm font-semibold">
                      {item.name}
                      {item.note && (
                        <span class="block text-xs font-normal text-mala-ink-soft">{item.note}</span>
                      )}
                    </span>
                    <span class="tnum shrink-0 text-sm text-mala-ink-soft">{item.grams} g</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="mt-8 flex items-start gap-2 text-sm font-semibold">
        <Icon name="scale" size={18} class="mt-0.5 shrink-0 text-mala-red" />
        Weights are averages. Your bowl is weighed at the counter and that number is the one you pay on.
      </p>
    </div>
  </section>

  <!-- Add ons -->
  <section id="add-ons" class="bg-white py-16 sm:py-20" aria-labelledby="addons-heading">
    <div class="container-rail">
      <SectionHeading
        id="addons-heading"
        eyebrow="On the side"
        title="Sides and drinks"
        lede="Ordered at the counter, priced per item, and not part of the weighed bowl."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          ADD_ON_GROUPS.map((group) => (
            <div class="print-block card-hard p-5">
              <h3 class="text-[1.375rem] text-mala-ink">{group.heading}</h3>
              <p class="mt-2 text-sm text-mala-ink-soft">{group.blurb}</p>
              <ul class="mt-4">
                {group.items.map((item) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-black/10 py-2 last:border-b-0">
                    <span class="text-sm font-semibold">{item.name}</span>
                    <span class="tnum shrink-0 text-sm font-bold text-mala-red">
                      {item.price === null ? (item.note ?? 'Included') : formatPrice(item.price)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-mala-ink-soft">
        Prices include service. Ask at the counter if you need anything left out of a bowl.
      </p>
    </div>
  </section>

  <CtaBand line="Come in hungry. Pick what you actually want." />
</Base>

<script>
  document.getElementById('print-menu')?.addEventListener('click', () => window.print());
</script>
