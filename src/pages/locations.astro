---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OpenStatus from '../components/OpenStatus.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

import { LOCATIONS, directionsLink, wazeLink } from '../data/locations';
import { SITE, whatsappLink } from '../data/site';
import { allRestaurantsSchema, breadcrumbSchema } from '../lib/schema';

const schemas = [
  ...allRestaurantsSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Locations', path: '/locations' },
  ]),
];
---

<Base
  title="Locations"
  description="Find Musafir Qi Stesen Mala at CBD Perdana 3, Cyberjaya. Open 10:30 AM to 11:30 PM daily."
  path="/locations"
  schemas={schemas}
>
  <section class="on-red bg-mala-red py-14 text-white sm:py-20">
    <div class="container-rail">
      <p class="text-xs font-bold tracking-[0.2em] text-white uppercase">Walk in</p>
      <h1 class="gold-on-red mt-3 max-w-3xl text-[length:var(--text-display-lg)]">Find us</h1>
      <p class="mt-5 max-w-2xl text-lg text-white">
        One outlet in Cyberjaya. No booking and no waiting list. Come in, take a bowl, and start
        filling.
      </p>

    </div>
    <div class="h-1 w-full bg-mala-gold"></div>
  </section>

  {
    LOCATIONS.map((location, index) => (
      <section
        id={location.id}
        class:list={[
          'scroll-mt-24 py-16 sm:py-20',
          index % 2 === 0 ? 'bg-white' : 'bg-mala-cream',
        ]}
        aria-labelledby={`${location.id}-heading`}
      >
        <div class="container-rail">
          <SectionHeading
            id={`${location.id}-heading`}
            eyebrow="Our outlet"
            title={location.name}
            lede={location.room}
          />

          <div class="mt-10 grid gap-8 lg:grid-cols-2 lg:items-start">
            <!-- Details -->
            <div>
              <img
                src={location.image}
                alt={location.imageAlt}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full rounded-sm border-2 border-mala-ink object-cover"
              />

              {
                location.imageNight && (
                  <img
                    src={location.imageNight}
                    alt={location.imageNightAlt}
                    width="660"
                    height="440"
                    loading="lazy"
                    decoding="async"
                    class="mt-4 aspect-[3/2] w-full rounded-sm border-2 border-mala-ink object-cover"
                  />
                )
              }

              <div class="mt-6">
                <OpenStatus location={location} />
              </div>

              <dl class="mt-5 space-y-5">
                <div class="flex gap-3">
                  <Icon name="pin" size={20} class="mt-0.5 shrink-0 text-mala-red" />
                  <div>
                    <dt class="text-sm font-bold tracking-widest uppercase">Address</dt>
                    <dd class="mt-1 text-mala-ink-soft">
                      {location.streetAddress}
                      <br />
                      {location.locality}, {location.region} {location.postalCode}
                    </dd>
                  </div>
                </div>

                <div class="flex gap-3">
                  <Icon name="clock" size={20} class="mt-0.5 shrink-0 text-mala-red" />
                  <div>
                    <dt class="text-sm font-bold tracking-widest uppercase">Hours</dt>
                    <dd class="mt-1 text-mala-ink-soft">{location.hoursDisplay}</dd>
                  </div>
                </div>

                <div class="flex gap-3">
                  <Icon name="phone" size={20} class="mt-0.5 shrink-0 text-mala-red" />
                  <div>
                    <dt class="text-sm font-bold tracking-widest uppercase">Phone</dt>
                    <dd class="mt-1">
                      <a
                        href={`tel:${location.phoneDisplay.replace(/\s/g, '')}`}
                        class="text-mala-ink-soft underline decoration-mala-gold decoration-2 underline-offset-4"
                      >
                        {location.phoneDisplay}
                      </a>
                    </dd>
                  </div>
                </div>

                <div class="flex gap-3">
                  <Icon name="directions" size={20} class="mt-0.5 shrink-0 text-mala-red" />
                  <div>
                    <dt class="text-sm font-bold tracking-widest uppercase">Parking</dt>
                    <dd class="mt-1 text-mala-ink-soft">{location.parking}</dd>
                  </div>
                </div>
              </dl>

              <div class="mt-6">
                <h3 class="text-sm font-bold tracking-widest uppercase" style="font-family: var(--font-body);">
                  Nearby landmarks
                </h3>
                <ul class="mt-3 space-y-2">
                  {location.landmarks.map((landmark) => (
                    <li class="flex gap-3 text-sm text-mala-ink-soft">
                      <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-mala-gold" />
                      {landmark}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-7 flex flex-wrap gap-3">
                <a
                  href={directionsLink(location)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-primary flex-1 min-w-[140px]"
                >
                  <Icon name="google" size={18} />
                  Google Maps
                </a>
                <a
                  href={wazeLink(location)}
                  target="_blank"
                  rel="noopener"
                  class="btn bg-cyan-600 hover:bg-cyan-700 text-white flex-1 min-w-[120px]"
                >
                  <Icon name="waze" size={18} />
                  Waze
                </a>
                <a
                  href={whatsappLink(
                    `Hi ${SITE.name}, I would like to ask about ordering.`
                  )}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-green flex-1 min-w-[140px]"
                >
                  <Icon name="whatsapp" size={18} />
                  WhatsApp
                </a>
              </div>
            </div>

            <!-- Map -->
            <div class="lg:sticky lg:top-28">
              <MapEmbed location={location} />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand line="Message us if you cannot find the door." />
</Base>
